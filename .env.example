# ============================================================================
# Kasparro Auditor — environment configuration template
# Copy to `.env` and fill in real values. Never commit real secrets.
# ============================================================================

# ---- Runtime mode ----------------------------------------------------------
# EXECUTION_MODE controls the LLM adapter the pipeline uses.
#   live    : call Groq with a real API key (requires hiring-team approval)
#   local   : call Ollama or another OpenAI-compatible local endpoint
#   replay  : return cached responses from data_pack/replay/{response_id}.json
#   stub    : deterministic hardcoded outputs (for tests)
EXECUTION_MODE=live

# ---- Server ----------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ---- Database --------------------------------------------------------------
# SQLite is sufficient for the assignment. Use a file path for persistence.
DATABASE_URL=sqlite+aiosqlite:///./kasparro.db

# ---- LLM provider (Groq) --------------------------------------------------
# IMPORTANT: Groq retired llama-3.3-70b-versatile and llama-3.1-8b-instant on
# 16 August 2026 (free + developer tiers). Use openai/gpt-oss-120b instead.
# Free-tier rate limit: 30 RPM / 1,000 RPD / 8K TPM.
# A personal Groq key is NOT approved access by default — see LOCAL mode below.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_OUTPUT_TOKENS=1024
GROQ_TEMPERATURE=0.0

# ---- LLM provider (Ollama, approved local model) ---------------------------
# Used when EXECUTION_MODE=local. The brief requires "a local model or hosted
# access explicitly provided or approved by the hiring team". A personal Groq
# key is NOT that by default. Use Ollama (https://ollama.com) as a local,
# OpenAI-compatible alternative. Install a model first: `ollama pull llama3.1:8b`.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=ollama

# ---- Auth (two local identities, NOT OAuth) --------------------------------
# Tokens are read from the environment. Caller-supplied roles are ignored.
ANALYST_TOKEN=analyst-local-token-change-me
REVIEWER_TOKEN=reviewer-local-token-change-me
ANALYST_ACTOR_ID=analyst-001
REVIEWER_ACTOR_ID=reviewer-001

# ---- Pipeline guards -------------------------------------------------------
# Free-tier Groq limit is 30 RPM. Concurrency=2 leaves margin.
MAX_CONCURRENT_LLM_CALLS=1
ANALYSIS_TIMEOUT_SECONDS=900
MAX_LLM_CALLS_PER_RUN=200

# ---- Paths -----------------------------------------------------------------
DATA_PACK_DIR=./data_pack
REPLAY_CACHE_DIR=./data_pack/replay
